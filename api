local activeThreads = {}

local function stopAllThreads()
    for _, ctrl in pairs(activeThreads) do
        ctrl.stopFlag = true
    end
    activeThreads = {}
end

local function startEggThread(plotId, slot, delay, qty)
    local ctrl = { stopFlag = false }
    activeThreads[slot] = ctrl
    task.spawn(function()
        while not ctrl.stopFlag do
            purchaseEgg(plotId, slot, qty)
            task.wait(delay)
        end
        if PRINT_VERBOSE then
            print('🛑 Dừng slot', slot)
        end
    end)
end

-- ==============================
-- 💡 TIER LOGIC (đơn giản hóa)
-- ==============================
-- 💰 Mốc tiền mở nhà (House Unlock Thresholds)
-- COIN_THRESHOLDS[1] = 1e6   → 1,000,000 coins  -> mở House #1
-- COIN_THRESHOLDS[2] = 5e6   → 5,000,000 coins  -> mở House #2
-- COIN_THRESHOLDS[3] = 2e7   → 20,000,000 coins -> mở House #3
-- COIN_THRESHOLDS[4] = 5e7   → 50,000,000 coins -> mở House #4
-- COIN_THRESHOLDS[5] = 1e8   → 100,000,000 coins-> mở House #5
local COIN_THRESHOLDS = { 1e6, 2e6, 5e7, 3e7, 5e7 }

local function decideTierAndActions(amount, coins)
    local tier = (amount < 1000 and 1)
        or (amount > 15000 and 4)
        or (amount > 8000 and 3)
        or (amount > 2000 and 2)
        or 1

    local houses, qty = {}, {}
    if coins >= COIN_THRESHOLDS[1] then
        houses[1] = true
        qty[1] = 3
    end
    if coins >= COIN_THRESHOLDS[2] then
        houses[2] = true
        qty[2] = 3
    end
    if coins >= COIN_THRESHOLDS[3] then
        houses[3] = true
        qty[3] = 1
    end
    if coins >= COIN_THRESHOLDS[4] then
        houses[4] = true
        qty[4] = 1
    end
    if coins >= COIN_THRESHOLDS[5] then
        houses[5] = true
        qty[5] = 1
    end
    return houses, qty
end

